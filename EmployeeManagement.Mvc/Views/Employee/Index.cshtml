@model IEnumerable<EmployeeManagement.Mvc.Models.EmployeeDTo>
<style>
    .card {
        margin: auto;
        margin-top: 50px;
        max-width: auto;
        padding: 20px;
        border: 1px solid #ddd;
        border-radius: 5px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }   
</style>
<div class="row">
    <div class="col-md-6 card">
        @await Html.PartialAsync("_EmployeeListPV", Model)
    </div>
    <div class="col-md-6 card">
        @await Html.PartialAsync("_AddNewEmployeePV", Model)
    </div>
</div>